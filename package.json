{
  "name": "client-app",
  "version": "0.1.0",
  "private": true,
  "description": "A client project from the software factory: Next.js on Cloudflare Workers, with Supabase.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/lib/**/*.test.ts\"",
    "knip": "knip",
    "db:start": "supabase start --exclude studio,imgproxy,realtime,edge-runtime,logflare,vector,supavisor,postgres-meta",
    "db:stop": "supabase stop",
    "test:db": "supabase test db",
    "test:e2e": "bash scripts/e2e.sh",
    "test:e2e:update": "bash scripts/e2e.sh --update-snapshots=changed",
    "worker:build": "opennextjs-cloudflare build",
    "worker:preview": "opennextjs-cloudflare preview",
    "guard": "node scripts/guard.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.19",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "knip": "^6.45.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "3.1.0",
    "tailwindcss": "^4.3.4",
    "typescript": "5.9",
    "wrangler": "^4.168.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
