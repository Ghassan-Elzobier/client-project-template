# Copy to .env.local for `npm run dev`. The values for the local stack come from
# `npx supabase status` after `npm run db:start`. Never commit a filled-in copy.

# Supabase: the project URL and its public (anon) key. Built into the pages, so
# the browser can sign in; the database decides what each caller may do.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The site's public address, for sign-in links sent by email. Blank: worked out
# from the request.
NEXT_PUBLIC_SITE_URL=
